# SaaS backend base URL. No trailing slash.
# Development:
VITE_API_BASE_URL=http://localhost:5050
# Production (set at build time):
# VITE_API_BASE_URL=https://api.example.com

# Public Company Dashboard origin for the Super Admin "Open customer signup" link.
# Do not hardcode a guessed production domain.
# Development example:
# VITE_COMPANY_APP_BASE_URL=http://localhost:5173
# Production example:
# VITE_COMPANY_APP_BASE_URL=https://app.example.com

# Public variables only. Never put JWT secrets, Supabase service keys, or provider tokens here.
